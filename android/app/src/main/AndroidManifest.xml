<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Both, and FINE is not optional: from Android 12 a coarse-only app is handed a
         deliberately fuzzed fix, randomised within a grid cell of roughly a kilometre
         or two. For a transit app that is not a rounding error: it puts you in the
         next town, so the planner boards you at stops you cannot walk to and the place
         search ranks the wrong city first. Read once per session, never stored. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Only to read the QR code on a bus when paying for a ride; asked for then,
         and a phone without a camera can still install Kav. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Routing goes through Moovit's own servers, so planning a trip needs a
         connection. The map is the part that does not: its tiles are bundled and
         read from disk, so the map still draws with the radio off. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Updates come from GitHub releases and are handed to the system installer;
         Android asks you once, per app, before it will take an APK from one. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- A trip under way lives in the shade as an ongoing notification. Its service
         follows your location so the steps move with the phone, "special use" keeps it
         up when location isn't granted, and Android 16 shows it as a live update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Deliberately NOT declared, and why each one is refused:
           ADVERTISING_ID            - there is no advertising
           ACCESS_BACKGROUND_LOCATION- nothing tracks you between sessions
           GET_ACCOUNTS / CONTACTS   - there are no accounts -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Kav"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:largeHeap="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared trips use Moovit's itinerary links, including its OneLink wrappers.
                 Legacy directions links still work. singleTask above routes a
                 link into the running copy instead of stacking a second one. The
                 https form belongs to their site, so Android will not hand it over
                 without being told to; the moovit: scheme has no owner to verify,
                 and that one offers Kav in the chooser as it should. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moovit" android:host="directions" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="moovitapp.com" android:path="/directions" />
                <data android:scheme="https" android:host="www.moovitapp.com" android:path="/directions" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="moovitapp.com" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="www.moovitapp.com" android:pathPrefix="/i/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moovit" android:host="i" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="moovit.onelink.me" />
            </intent-filter>
            <!-- Lines and stops shared from Moovit. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moovit" android:host="line" />
                <data android:scheme="moovit" android:host="station" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="moovitapp.com" android:path="/line" />
                <data android:scheme="https" android:host="moovitapp.com" android:pathPrefix="/station/" />
            </intent-filter>
            <!-- geo: points and place names, so Kav is offered as a navigation app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <!-- A .kav backup tapped in a file manager. Matched by the name's ending
                 rather than a type, because .kav has no registered MIME and claiming
                 application/octet-stream would put Kav in the chooser for every
                 unknown file on the phone. pathPattern's wildcard does not cross a
                 dot, so a name with dots in it needs one line per dot; three covers
                 anything a rider is likely to have renamed a backup to. A file
                 manager that hands over a content:// URI carrying no name in its
                 path cannot be matched this way at all. Settings › Import is the
                 way in for those. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.kav" />
                <data android:pathPattern=".*\\..*\\.kav" />
                <data android:pathPattern=".*\\..*\\..*\\.kav" />
            </intent-filter>
            <!-- The same again with no mimeType, because a filter that declares one
                 only matches an intent that carries one. Android derives a file://
                 URI's type from its extension, and .kav is in no MIME map, so a file
                 manager sending a bare VIEW would miss the filter above entirely.
                 Verified both ways with `cmd package query-activities`. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.kav" />
                <data android:pathPattern=".*\\..*\\.kav" />
                <data android:pathPattern=".*\\..*\\..*\\.kav" />
            </intent-filter>
        </activity>

        <!-- the ongoing trip notification's anchor -->
        <service
            android:name=".TripService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ongoing transit trip status" />
        </service>

        <!-- the downloaded update, readable by the installer and nobody else -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
